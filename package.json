{
  "name": "worship-presenter",
  "version": "2.0.0",
  "description": "Sistema de proyección ProPresenter v2 para Ubuntu: Playlists de servicio, Catálogo de canciones, Biblia offline, Reloj contador de inicio, Medios de programa y Túnel Cloudflare",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
